# Every one of these is optional. Unset means that subsystem runs in-process and
# /health reports the degraded mode.

# DATABASE_URL=postgresql://governance:governance@localhost:5432/governance
# REDIS_URL=redis://localhost:6379
# OPA_URL=http://localhost:8181

FLEET_DAILY_CAP=50000000        # cents; ceiling above every per-agent cap
SEED_DEMO_DATA=1                # 0 to boot with an empty ledger
SEED_DECISIONS=320              # ceiling on backfilled rows, not a target
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
